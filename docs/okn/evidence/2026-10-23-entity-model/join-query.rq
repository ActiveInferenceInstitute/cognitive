PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX schema: <https://schema.org/>
SELECT DISTINCT ?page ?concept ?label ?wikidata ?external ?externalLabel ?source
WHERE {
  GRAPH <https://purl.org/okn/frink/kg/cognitive-kb> {
    ?concept a skos:Concept ; skos:prefLabel ?label ;
             (skos:exactMatch|skos:closeMatch) ?wikidata .
    ?page schema:about ?concept ; dcterms:source ?source .
    FILTER(STRSTARTS(STR(?wikidata), "http://www.wikidata.org/entity/"))
  }
  GRAPH <https://purl.org/okn/frink/kg/identifier-mappings> {
    ?wikidata skos:exactMatch ?external .
  }
  GRAPH <https://purl.org/okn/frink/kg/ubergraph> {
    ?external rdfs:label ?externalLabel .
  }
  FILTER(STRSTARTS(STR(?external), "http://purl.obolibrary.org/obo/"))
}
ORDER BY ?concept ?external ?externalLabel
