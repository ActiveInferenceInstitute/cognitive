page:biology\/serotonin
    a skos:Concept, schema:CreativeWork ;
    dcterms:created "2026-10-10"^^xsd:date ;
    dcterms:description "Serotonin (5-HT) as a monoamine neuromodulator with widespread projections from the raphe nuclei, its receptor diversity, proposed roles in mood and patience, and hypotheses linking it to precision and priors."@en ;
