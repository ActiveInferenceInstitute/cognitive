kg:mapping\/7f134b7453978a2bf82cf679172216d3f560fa84df52567039897551f121f876
    a rdf:Statement ;
    dcterms:date "2026-10-20"^^xsd:date ;
    dcterms:description "NCI defines cortisol as the glucocorticoid hormone produced by the adrenal cortex; this is the substance denoted by the source page, not a particular molecule or administered dose."@en ;
    dcterms:source <https://api-evsrest.nci.nih.gov/api/v1/concept/ncit/C2290> ;
    rdf:object <http://purl.obolibrary.org/obo/NCIT_C2290> ;
    rdf:predicate skos:exactMatch ;
    rdf:subject page:biology\/cortisol .

kg:mapping\/beb9989e3a319fe84b4168dc6b6614895a16d7edbb1f6eee146b90bfb3342ad1
    a rdf:Statement ;
    dcterms:date "2026-10-20"^^xsd:date ;
    dcterms:description "The page's opening identifies the steroid hormone cortisol produced by the adrenal cortex. ChEBI identifies that same chemical substance, rather than a cortisol assay, secretion process, or signaling pathway."@en ;
    dcterms:source <https://www.ebi.ac.uk/chebi/CHEBI:17650> ;
    rdf:object <http://purl.obolibrary.org/obo/CHEBI_17650> ;
    rdf:predicate skos:exactMatch ;
    rdf:subject page:biology\/cortisol .

kg:mapping\/c9e4fe519016c9c6bd653a40a966ee28df28d846d2324b18b1d80ecc3e9734b4
    a rdf:Statement ;
    dcterms:date "2026-10-20"^^xsd:date ;
    dcterms:description "The page identifies the glucocorticoid steroid hormone cortisol, the same substance denoted by the target. The assertion concerns the concept, not identity of the Markdown document with a molecule."@en ;
    dcterms:source <https://www.wikidata.org/wiki/Q190875> ;
    rdf:object <http://www.wikidata.org/entity/Q190875> ;
    rdf:predicate skos:exactMatch ;
    rdf:subject page:biology\/cortisol .

page:biology\/cortisol
    a skos:Concept, schema:CreativeWork ;
    dcterms:created "2026-10-10"^^xsd:date ;
    dcterms:description "Cortisol as the main human glucocorticoid, released through the HPA axis in response to stress and circadian cues, with its physiological effects and an allostatic Active Inference interpretation."@en ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:references page:biology\/allostatic_regulation, page:biology\/amygdala, page:biology\/homeostasis, page:biology\/serotonin, page:cognitive\/allostatic_control, page:cognitive\/anxiety, page:cognitive\/emotional_processing, page:cognitive\/interoception, page:cognitive\/oxytocin ;
    dcterms:source <https://github.com/ActiveInferenceInstitute/cognitive/blob/main/knowledge_base/biology/cortisol.md> ;
    dcterms:title "Cortisol"@en ;
    rdfs:seeAlso <http://www.wikidata.org/entity/Q190875> ;
    skos:altLabel "cortisol_system"@en ;
    skos:definition "The chemical substance cortisol (hydrocortisone), the glucocorticoid steroid hormone produced by the adrenal cortex."@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/CHEBI_17650>, <http://purl.obolibrary.org/obo/NCIT_C2290>, <http://www.wikidata.org/entity/Q190875> ;
    skos:inScheme kg:scheme ;
    skos:prefLabel "Cortisol"@en ;
    skos:related page:biology\/allostatic_regulation, page:biology\/homeostasis, page:cognitive\/emotional_processing ;
    skos:scopeNote "The mapped concept is the chemical substance, not the HPA axis, cortisol secretion, an assay, a drug product, or a particular molecule. Physiological mechanisms and Active Inference interpretations below provide context for this substance."@en ;
    ckb:pageType "biology" ;
    ckb:status "stable" ;
    schema:keywords kg:keyword\/endocrine, kg:keyword\/hormone, kg:keyword\/stress .

