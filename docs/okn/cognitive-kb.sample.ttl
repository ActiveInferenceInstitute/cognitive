kg:mapping\/0d128dbe25b593182e20596aec6b220fd90e2284591c37802062fb598b121a8e
    a rdf:Statement ;
    dcterms:date "2026-10-20"^^xsd:date ;
    dcterms:description "The source describes categorical, Dirichlet and Gaussian families by their probability mass or density functions for random variables. STATO defines a probability distribution as information specifying a random variable's probabilities, including discrete formulas and continuous densities. Both denote the distribution concept, not a particular numerical distribution instance."@en ;
    dcterms:source <https://www.ebi.ac.uk/ols4/api/ontologies/stato/terms?obo_id=STATO:0000225> ;
    rdf:object <http://purl.obolibrary.org/obo/STATO_0000225> ;
    rdf:predicate skos:exactMatch ;
    rdf:subject page:mathematics\/probability_distributions .

kg:mapping\/6317025996f8ad508fde0857d9cca2f0d00fe158e67154a238a36e4722990207
    a rdf:Statement ;
    dcterms:date "2026-10-20"^^xsd:date ;
    dcterms:description "The source names serotonin as 5-hydroxytryptamine, a monoamine neurotransmitter and neuromodulator. ChEBI defines the same primary amine as the 5-hydroxy derivative of tryptamine. The source's CNS focus concerns this chemical; it does not denote the whole serotonergic system or a drug preparation."@en ;
    dcterms:source <https://www.ebi.ac.uk/chebi/CHEBI:28790> ;
    rdf:object <http://purl.obolibrary.org/obo/CHEBI_28790> ;
    rdf:predicate skos:exactMatch ;
    rdf:subject page:biology\/serotonin .

kg:mapping\/7f134b7453978a2bf82cf679172216d3f560fa84df52567039897551f121f876
    a rdf:Statement ;
    dcterms:date "2026-10-20"^^xsd:date ;
    dcterms:description "NCI defines cortisol as the glucocorticoid hormone produced by the adrenal cortex; this is the substance denoted by the source page, not a particular molecule or administered dose."@en ;
    dcterms:source <https://api-evsrest.nci.nih.gov/api/v1/concept/ncit/C2290> ;
    rdf:object <http://purl.obolibrary.org/obo/NCIT_C2290> ;
    rdf:predicate skos:exactMatch ;
    rdf:subject page:biology\/cortisol .

kg:mapping\/b983d0d0cba6521152d865a354ec00e324a25a7329e1fecd196bbf8157312215
    a rdf:Statement ;
    dcterms:date "2026-10-20"^^xsd:date ;
    dcterms:description "The source gives discrete Shannon entropy as the expected negative log probability, with conditional and joint forms. The target defines information entropy as expected information delivered by a message. Both denote Shannon information entropy, not thermodynamic entropy or a general notion of disorder."@en ;
    dcterms:source <https://www.wikidata.org/wiki/Q204570> ;
    rdf:object <http://www.wikidata.org/entity/Q204570> ;
    rdf:predicate skos:exactMatch ;
    rdf:subject page:mathematics\/entropy .

kg:mapping\/beb9989e3a319fe84b4168dc6b6614895a16d7edbb1f6eee146b90bfb3342ad1
    a rdf:Statement ;
    dcterms:date "2026-10-20"^^xsd:date ;
    dcterms:description "The page's opening identifies the steroid hormone cortisol produced by the adrenal cortex. ChEBI identifies that same chemical substance, rather than a cortisol assay, secretion process, or signaling pathway."@en ;
    dcterms:source <https://www.ebi.ac.uk/chebi/CHEBI:17650> ;
    rdf:object <http://purl.obolibrary.org/obo/CHEBI_17650> ;
    rdf:predicate skos:exactMatch ;
    rdf:subject page:biology\/cortisol .

kg:mapping\/c9e4fe519016c9c6bd653a40a966ee28df28d846d2324b18b1d80ecc3e9734b4
    a rdf:Statement ;
    dcterms:date "2026-10-20"^^xsd:date ;
    dcterms:description "The page identifies the glucocorticoid steroid hormone cortisol, the same substance denoted by the target. The assertion concerns the concept, not identity of the Markdown document with a molecule."@en ;
    dcterms:source <https://www.wikidata.org/wiki/Q190875> ;
    rdf:object <http://www.wikidata.org/entity/Q190875> ;
    rdf:predicate skos:exactMatch ;
    rdf:subject page:biology\/cortisol .

kg:mapping\/d3d3c59c30dbcb87db65407474cb59d3af2e1bc4d4d6526f15c5f621c34319c9
    a rdf:Statement ;
    dcterms:date "2026-10-20"^^xsd:date ;
    dcterms:description "The source defines using gene information to make a functional product, protein or non-coding RNA, and covers transcription, processing and translation. GO defines conversion of gene sequence into a mature protein or RNA product, including processing and maturation. Both denote gene expression, rather than transcription alone."@en ;
    dcterms:source <https://www.ebi.ac.uk/ols4/api/ontologies/go/terms?obo_id=GO:0010467> ;
    rdf:object <http://purl.obolibrary.org/obo/GO_0010467> ;
    rdf:predicate skos:exactMatch ;
    rdf:subject page:biology\/gene_expression .

kg:mapping\/e24718a5b56897a1b84942411fbf4f289259cb6a3d322b7afc0c37c31aac5368
    a rdf:Statement ;
    dcterms:date "2026-10-20"^^xsd:date ;
    dcterms:description "The source denotes serotonin, or 5-hydroxytryptamine, as a monoamine chemical messenger with central and peripheral roles. NCI's serotonin concept identifies 5-hydroxytryptamine as a neurotransmitter and hormone found in brain and peripheral tissues. The chemical denotation agrees; the mapping does not endorse every physiological statement in either description."@en ;
    dcterms:source <https://api-evsrest.nci.nih.gov/api/v1/concept/ncit/C828?include=full> ;
    rdf:object <http://purl.obolibrary.org/obo/NCIT_C828> ;
    rdf:predicate skos:exactMatch ;
    rdf:subject page:biology\/serotonin .

page:biology\/cortisol
    a skos:Concept, schema:CreativeWork ;
    dcterms:created "2026-10-10"^^xsd:date ;
    dcterms:description "Cortisol as the main human glucocorticoid, released through the HPA axis in response to stress and circadian cues, with its physiological effects and an allostatic Active Inference interpretation."@en ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:references page:biology\/allostatic_regulation, page:biology\/amygdala, page:biology\/homeostasis, page:biology\/serotonin, page:cognitive\/allostatic_control, page:cognitive\/anxiety, page:cognitive\/emotional_processing, page:cognitive\/interoception, page:cognitive\/oxytocin ;
    dcterms:source <https://github.com/ActiveInferenceInstitute/cognitive/blob/main/knowledge_base/biology/cortisol.md> ;
    dcterms:title "Cortisol"@en ;
    rdfs:seeAlso <http://www.wikidata.org/entity/Q190875> ;
    skos:altLabel "cortisol_system"@en ;
    skos:definition "The chemical substance cortisol (hydrocortisone), the glucocorticoid steroid hormone produced by the adrenal cortex."@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/CHEBI_17650>, <http://purl.obolibrary.org/obo/NCIT_C2290>, <http://www.wikidata.org/entity/Q190875> ;
    skos:inScheme kg:scheme ;
    skos:prefLabel "Cortisol"@en ;
    skos:related page:biology\/allostatic_regulation, page:biology\/homeostasis, page:cognitive\/emotional_processing ;
    skos:scopeNote "The mapped concept is the chemical substance, not the HPA axis, cortisol secretion, an assay, a drug product, or a particular molecule. Physiological mechanisms and Active Inference interpretations below provide context for this substance."@en ;
    ckb:pageType "biology" ;
    ckb:status "stable" ;
    schema:keywords kg:keyword\/endocrine, kg:keyword\/hormone, kg:keyword\/stress .

