concept:biology\/cortisol
    a skos:Concept ;
    skos:altLabel "cortisol_system"@en ;
    skos:definition "The chemical substance cortisol (hydrocortisone), the glucocorticoid steroid hormone produced by the adrenal cortex."@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/CHEBI_17650>, <http://purl.obolibrary.org/obo/NCIT_C2290>, <http://www.wikidata.org/entity/Q190875> ;
    skos:inScheme kg:scheme ;
    skos:prefLabel "Cortisol"@en ;
    skos:related concept:biology\/allostatic_regulation, concept:biology\/homeostasis, concept:cognitive\/emotional_processing ;
    skos:scopeNote "The mapped concept is the chemical substance, not the HPA axis, cortisol secretion, an assay, a drug product, or a particular molecule. Physiological mechanisms and Active Inference interpretations below provide context for this substance."@en .

concept:biology\/gene_expression
    a skos:Concept ;
    skos:exactMatch <http://purl.obolibrary.org/obo/GO_0010467> ;
    skos:inScheme kg:scheme ;
    skos:prefLabel "Gene Expression"@en ;
    skos:related concept:biology\/gene_regulatory_networks, concept:biology\/genetics, concept:biology\/molecular_biology .

concept:biology\/serotonin
    a skos:Concept ;
    skos:altLabel "serotonergic"@en, "serotonin_system"@en ;
    skos:definition "Serotonin (5-hydroxytryptamine, 5-HT), a monoamine chemical messenger whose tryptamine structure has a 5-hydroxy substituent."@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/CHEBI_28790>, <http://purl.obolibrary.org/obo/NCIT_C828> ;
    skos:inScheme kg:scheme ;
    skos:prefLabel "Serotonin"@en ;
    skos:related concept:cognitive\/computational_psychiatry, concept:cognitive\/dopamine_system, concept:cognitive\/emotional_processing ;
    skos:scopeNote "The subject is the named serotonin chemical substance, with an emphasis on its central nervous system roles. The mappings do not denote the whole serotonergic system, a particular physiological protonation state, an assay or a drug preparation."@en .

concept:cognitive\/emotion_regulation
    a skos:Concept ;
    skos:altLabel "emotional_regulation"@en, "gross_emotion_regulation"@en, "reappraisal"@en ;
    skos:inScheme kg:scheme ;
    skos:prefLabel "Emotion Regulation"@en ;
    skos:related concept:cognitive\/active_inference, concept:cognitive\/cognitive_control, concept:cognitive\/emotional_processing, concept:cognitive\/self_regulation .

concept:mathematics\/entropy
    a skos:Concept ;
    skos:altLabel "shannon_entropy"@en ;
    skos:definition "Shannon information entropy, the expected negative logarithm of the probability of a discrete outcome."@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q204570> ;
    skos:inScheme kg:scheme ;
    skos:prefLabel "Entropy"@en ;
    skos:related concept:mathematics\/information_theory, concept:mathematics\/kl_divergence, concept:mathematics\/mutual_information ;
    skos:scopeNote "This page treats Shannon entropy and its conditional and joint forms for discrete random variables. The correspondences do not identify it with thermodynamic entropy, differential entropy or generic disorder."@en ;
    rel:used_by concept:mathematics\/action_distribution, concept:mathematics\/expected_free_energy, concept:mathematics\/exploration_exploitation .

concept:mathematics\/markov_blanket
    a skos:Concept ;
    skos:inScheme kg:scheme ;
    skos:prefLabel "Markov Blanket"@en ;
    skos:related concept:mathematics\/bayesian_networks, concept:mathematics\/information_theory, concept:mathematics\/statistical_physics ;
    rel:foundation_for concept:cognitive\/active_inference, concept:mathematics\/free_energy_principle ;
