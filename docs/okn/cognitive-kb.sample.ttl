page:mathematics\/entropy
    a skos:Concept, schema:CreativeWork ;
    dcterms:created "2025-08-08"^^xsd:date ;
    dcterms:description "Short reference on Shannon, conditional and joint entropy, and its role as the uncertainty measure behind exploration and the ambiguity term of expected free energy."@en ;
    dcterms:references page:mathematics\/information_theory, page:mathematics\/kl_divergence, page:mathematics\/mutual_information ;
    dcterms:source <https://github.com/ActiveInferenceInstitute/cognitive/blob/main/knowledge_base/mathematics/entropy.md> ;
    dcterms:title "Entropy"@en ;
    skos:altLabel "shannon_entropy"@en ;
    skos:definition "Shannon information entropy, the expected negative logarithm of the probability of a discrete outcome."@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q204570> ;
    skos:inScheme kg:scheme ;
    skos:prefLabel "Entropy"@en ;
    skos:related page:mathematics\/information_theory, page:mathematics\/kl_divergence, page:mathematics\/mutual_information ;
    skos:scopeNote "This page treats Shannon entropy and its conditional and joint forms for discrete random variables. The correspondences do not identify it with thermodynamic entropy, differential entropy or generic disorder."@en ;
    rel:used_by page:mathematics\/action_distribution, page:mathematics\/expected_free_energy, page:mathematics\/exploration_exploitation ;
    ckb:pageType "mathematical_concept" ;
    ckb:status "stable" ;
    schema:keywords kg:keyword\/information-theory, kg:keyword\/uncertainty .

